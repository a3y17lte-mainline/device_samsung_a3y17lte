# Recovery: USB gadget for adb. Recovery's own init.rc creates the gadget, mounts FunctionFS
# and writes the UDC when sys.usb.configfs is 1; it only needs the controller's name (checked
# on the phone: /sys/class/udc).
on init
    # S-Boot's cmdline keeps the console quiet: log everything, pstore keeps the console
    write /proc/sys/kernel/printk "7 4 1 7"
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "13600000.usb"
