# Galaxy A3 (2017), mainline kernel. Also used in the first-stage ramdisk.
# super = PIT partition SYSTEM (androidboot.super_partition=SYSTEM).
# EFS, RADIO and the other Samsung partitions are not mounted.
#
# <src>                                    <mnt_point>  <type>  <mnt_flags and options>                      <fs_mgr_flags>
system                                     /system      erofs   ro                                           wait,logical,first_stage_mount
system_ext                                 /system_ext  erofs   ro                                           wait,logical,first_stage_mount
product                                    /product     erofs   ro                                           wait,logical,first_stage_mount
vendor                                     /vendor      erofs   ro                                           wait,logical,first_stage_mount
/dev/block/by-name/HIDDEN                  /metadata    ext4    noatime,nosuid,nodev,discard                 wait,check,formattable,first_stage_mount
/dev/block/by-name/CACHE                   /cache       ext4    noatime,nosuid,nodev,noauto_da_alloc,discard wait,check,formattable
# FBE in software (no inline crypto engine on the 7870 under mainline; software KeyMint).
/dev/block/by-name/USERDATA                /data        f2fs    noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,fsync_mode=nobarrier latemount,wait,check,formattable,fileencryption=aes-256-xts:aes-256-cts:v2,quota,reservedsize=128M,checkpoint=fs

# Raw partitions (recovery / OTA)
/dev/block/by-name/BOOT                    /boot        emmc    defaults                                     defaults
/dev/block/by-name/RECOVERY                /recovery    emmc    defaults                                     defaults

# Removable storage
/devices/platform/soc@0/13560000.mmc/mmc_host*            auto         auto    defaults                                     voldmanaged=sdcard1:auto,encryptable=userdata
/devices/platform/soc@0/soc@0:usb@13600000/*            auto         auto    defaults                                     voldmanaged=usb:auto

# zram (2 GB RAM): as large as the RAM. Pages compress about 3.8:1 here (lz4), so a full
# device costs about a quarter of the RAM; at 50% a 1.3 GB app could not fit
/dev/block/zram0                           none         swap    defaults                                     zramsize=100%
