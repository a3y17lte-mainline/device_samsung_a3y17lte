soong_namespace {
}

// Template the supplicant copies to /data/vendor/wifi/wpa on first start
// (AOSP's wpa_supplicant.conf module is gone; the template is a genrule now).
prebuilt_etc {
    name: "wpa_supplicant_a3y17lte.conf",
    filename: "wpa_supplicant.conf",
    src: ":wpa_supplicant_conf_gen",
    sub_dir: "wifi",
    vendor: true,
}

// Settings the supplicant reads on top of that file at every start
prebuilt_etc {
    name: "wpa_supplicant_overlay_a3y17lte.conf",
    filename: "wpa_supplicant_overlay.conf",
    src: "configs/wifi/wpa_supplicant_overlay.conf",
    sub_dir: "wifi",
    vendor: true,
}

// Prepares the modem's NV working copy and firmware image on /data before the
// radio HAL starts (see the script)
sh_binary {
    name: "modem-setup.sh",
    src: "rootdir/bin/modem-setup.sh",
    vendor: true,
}

// The modem's firmware image and NV data, as the kernel requests them (the DT's
// firmware-name): S-Boot passes firmware_class.path=/vendor/firmware, so the files are
// links from there to what modem-setup.sh prepares on /data. The kernel reads them itself
// (partial firmware reads have no ueventd fallback) and follows the links.
install_symlink {
    name: "modem-firmware-link",
    vendor: true,
    installed_location: "firmware/samsung/a3y17lte/modem.bin",
    symlink_target: "/data/vendor/modem/firmware/samsung/a3y17lte/modem.bin",
}

install_symlink {
    name: "modem-nv-link",
    vendor: true,
    installed_location: "firmware/samsung/a3y17lte/modem-nv.bin",
    symlink_target: "/data/vendor/modem/nv/nv_data.bin",
}

