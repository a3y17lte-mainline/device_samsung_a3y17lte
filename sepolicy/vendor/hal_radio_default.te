# The radio HAL (shannond): the modem's Samsung IPC ports, the NV working copy it keeps for the
# modem (RFS), and the packet data links it creates on the WWAN device over rtnetlink
allow hal_radio_default radio_device:chr_file rw_file_perms;
allow hal_radio_default vendor_data_file:dir search;
allow hal_radio_default vendor_modem_data_file:dir rw_dir_perms;
allow hal_radio_default vendor_modem_data_file:file create_file_perms;
allow hal_radio_default self:capability { net_admin net_raw };
allow hal_radio_default self:netlink_route_socket { create_socket_perms_no_ioctl nlmsg_write };
allow hal_radio_default sysfs_net:dir r_dir_perms;

# The kernel reads the firmware image and the NV data itself (firmware_class.path) with its
# own credentials. VERIFY when switching to enforcing: the platform's neverallow on core
# domains opening vendor data files may reject this; then move the files to a location the
# kernel may read.
# allow kernel vendor_modem_data_file:dir search;
# allow kernel vendor_modem_data_file:{ file lnk_file } { read open getattr };
