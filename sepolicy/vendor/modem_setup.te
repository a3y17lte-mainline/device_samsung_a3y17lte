# modem-setup.sh: copies the NV files from the read-only EFS mount and the firmware image from
# the RADIO partition to /data/vendor/modem once, before the radio HAL starts
type modem_setup, domain;
type modem_setup_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(modem_setup)

allow modem_setup vendor_shell_exec:file rx_file_perms;
allow modem_setup vendor_toolbox_exec:file rx_file_perms;
allow modem_setup self:capability { chown fowner dac_override };
allow modem_setup kmsg_device:chr_file w_file_perms;

allow modem_setup block_device:dir search;
allow modem_setup a3_radio_block_device:blk_file r_file_perms;
allow modem_setup a3_efs_file:dir r_dir_perms;
allow modem_setup a3_efs_file:file r_file_perms;

allow modem_setup vendor_data_file:dir search;
allow modem_setup vendor_modem_data_file:dir create_dir_perms;
allow modem_setup vendor_modem_data_file:file create_file_perms;
allow modem_setup vendor_modem_data_file:lnk_file create_file_perms;
