# The sensor hub's IIO devices: found by name under /sys/bus/iio/devices, set up through their
# sysfs attributes, read from /dev/iio:deviceN (buffers) and its event fd (proximity)
allow hal_sensors_default sysfs:dir r_dir_perms;
allow hal_sensors_default sysfs_a3_sensors:dir r_dir_perms;
allow hal_sensors_default sysfs_a3_sensors:file rw_file_perms;
allow hal_sensors_default sysfs_a3_sensors:lnk_file read;
allow hal_sensors_default iio_device:chr_file rw_file_perms;
