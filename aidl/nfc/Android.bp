cc_binary {
    name: "android.hardware.nfc-service.a3y17lte",
    relative_install_path: "hw",
    init_rc: ["android.hardware.nfc-service.a3y17lte.rc"],
    vintf_fragments: ["android.hardware.nfc-service.a3y17lte.xml"],
    vendor: true,
    srcs: [
        "Nfc.cpp",
        "main.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "android.hardware.nfc-V2-ndk",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    required: ["libnfc-nci_a3y17lte.conf"],
}

prebuilt_etc {
    name: "libnfc-nci_a3y17lte.conf",
    src: "libnfc-nci.conf",
    filename: "libnfc-nci.conf",
    vendor: true,
}
