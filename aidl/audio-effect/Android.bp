// AOSP's audio effects service (hardware/interfaces/audio/aidl/default). There it is only
// built for an APEX that also carries the example core HAL (installable: false, and no
// filegroup for its sources), so EffectFactory.cpp and EffectMain.cpp are unchanged copies from
// android-17.0.0_r1. Outside an APEX they look for the config and the effect libraries under
// /vendor (audio_effects_config.xml, lib64/soundfx).
cc_binary {
    name: "android.hardware.audio.effect.service-aidl.a3y17lte",
    relative_install_path: "hw",
    defaults: ["aidlaudioeffectservice_defaults"],
    init_rc: ["android.hardware.audio.effect.service-aidl.a3y17lte.rc"],
    vintf_fragments: ["android.hardware.audio.effect.service-aidl.a3y17lte.xml"],
    shared_libs: [
        "libapexsupport",
        "libeffectconfig",
    ],
    srcs: [
        "EffectFactory.cpp",
        "EffectMain.cpp",
    ],
    // The effect libraries (frameworks/av) are not visible to device modules, so they cannot
    // be "required" here: device.mk lists them in PRODUCT_PACKAGES.
    required: ["audio_effects_config_a3y17lte.xml"],
}

prebuilt_etc {
    name: "audio_effects_config_a3y17lte.xml",
    src: "audio_effects_config.xml",
    filename: "audio_effects_config.xml",
    vendor: true,
}
