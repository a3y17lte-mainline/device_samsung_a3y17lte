<?xml version="1.0" encoding="UTF-8"?>
<!--
    Mixer routing of the a3y17lte card (libaudioroute, applied by the audio HAL per device).

    I2S0 -> audio mixer (DMIX, AP port) -> codec2codec 48 kHz ->
        COD3026X: earpiece (mono), headphones, MIC1 main / MIC2 second / MIC3 headset
        TFA9896 ("Speaker" prefix): loudspeaker, plays the left channel
    Capture: codec ADC -> mixer -> AP ("AP Capture Source" = Codec).

    "Speaker Switch" is a pin switch of the card (pin-switches in the board DT): the TFA9896
    has no switch of its own.
-->
<mixer>
    <!-- Initial state, and what audio_route_reset returns to -->
    <ctl name="DMIX AP Switch" value="1" />
    <ctl name="AP Playback Volume" value="7" />
    <ctl name="AP Capture Source" value="Codec" />
    <ctl name="Speaker Amp Input" value="Left" />
    <ctl name="Speaker Switch" value="0" />
    <ctl name="Earpiece Switch" value="0" />
    <ctl name="Headphone Switch" value="0" />
    <ctl name="Mono Mix" value="Disable" />
    <ctl name="ADCL Mixer MIC1 Switch" value="0" />
    <ctl name="ADCR Mixer MIC1 Switch" value="0" />
    <ctl name="ADCL Mixer MIC2 Switch" value="0" />
    <ctl name="ADCR Mixer MIC2 Switch" value="0" />
    <ctl name="ADCL Mixer MIC3 Switch" value="0" />
    <ctl name="ADCR Mixer MIC3 Switch" value="0" />
    <ctl name="DMIX Modem Switch" value="0" />
    <ctl name="Modem Uplink Source" value="Mixer" />

    <!-- Outputs -->
    <path name="speaker">
        <ctl name="Speaker Switch" value="1" />
    </path>

    <path name="earpiece">
        <ctl name="Mono Mix" value="(L+R)/2" />
        <ctl name="Earpiece Switch" value="1" />
    </path>

    <path name="headphones">
        <ctl name="Headphone Switch" value="1" />
    </path>

    <!-- Inputs: both ADC channels from one microphone -->
    <path name="main-mic">
        <ctl name="ADCL Mixer MIC1 Switch" value="1" />
        <ctl name="ADCR Mixer MIC1 Switch" value="1" />
    </path>

    <path name="second-mic">
        <ctl name="ADCL Mixer MIC2 Switch" value="1" />
        <ctl name="ADCR Mixer MIC2 Switch" value="1" />
    </path>

    <path name="headset-mic">
        <ctl name="ADCL Mixer MIC3 Switch" value="1" />
        <ctl name="ADCR Mixer MIC3 Switch" value="1" />
    </path>

    <!--
        A phone call, on top of the output and input paths: the modem's downlink into the
        mixer and the codec's capture as its uplink. The modem plays on the left channel
        only, so the codec copies left to both ("MonoMix Mode" L in stock, for every output).

        Routes and gains are stock Android's for a call (mixer_paths.xml and mixer_gains.xml,
        incall_nb-*). The vendor driver's volume controls have our scales, except the digital
        DAC and ADC volumes, which are one step higher there (127 there is 126 here).
        Handset and speaker calls send both microphones, main on the left channel and second
        on the right: the modem's noise suppression works on the pair.
    -->
    <path name="call">
        <ctl name="DMIX Modem Switch" value="1" />
        <ctl name="Modem Uplink Source" value="Codec" />
        <ctl name="Mono Mix" value="Left" />
        <ctl name="DAC Playback Volume" value="126" />
    </path>

    <path name="call-handset">
        <ctl name="Earpiece Playback Volume" value="2" />
    </path>

    <path name="call-speaker">
    </path>

    <path name="call-headset">
        <ctl name="Headphone Playback Volume" value="32" />
    </path>

    <path name="call-headphone">
        <ctl name="Headphone Playback Volume" value="32" />
    </path>

    <path name="call-handset-mic">
        <ctl name="ADCL Mixer MIC1 Switch" value="1" />
        <ctl name="ADCR Mixer MIC2 Switch" value="1" />
        <ctl name="MIC1 Volume" value="16" />
        <ctl name="MIC1 Boost Volume" value="1" />
        <ctl name="MIC2 Volume" value="16" />
        <ctl name="MIC2 Boost Volume" value="1" />
        <ctl name="ADC Capture Volume" value="126" />
    </path>

    <path name="call-speaker-mic">
        <ctl name="ADCL Mixer MIC1 Switch" value="1" />
        <ctl name="ADCR Mixer MIC2 Switch" value="1" />
        <ctl name="MIC1 Volume" value="13" />
        <ctl name="MIC1 Boost Volume" value="2" />
        <ctl name="MIC2 Volume" value="13" />
        <ctl name="MIC2 Boost Volume" value="2" />
        <ctl name="ADC Capture Volume" value="126" />
    </path>

    <path name="call-headset-mic">
        <ctl name="ADCL Mixer MIC3 Switch" value="1" />
        <ctl name="ADCR Mixer MIC3 Switch" value="1" />
        <ctl name="MIC3 Volume" value="11" />
        <ctl name="MIC3 Boost Volume" value="1" />
        <ctl name="ADC Capture Volume" value="132" />
    </path>

    <path name="call-headphone-mic">
        <ctl name="ADCL Mixer MIC1 Switch" value="1" />
        <ctl name="ADCR Mixer MIC1 Switch" value="1" />
        <ctl name="MIC1 Volume" value="16" />
        <ctl name="MIC1 Boost Volume" value="1" />
        <ctl name="ADC Capture Volume" value="126" />
    </path>
</mixer>
